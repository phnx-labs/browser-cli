#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/user/.local/share/pnpm/global/5/.pnpm/@phnx-labs+browser-cli@0.2.15/node_modules/@phnx-labs/browser-cli/node_modules:/home/user/.local/share/pnpm/global/5/.pnpm/@phnx-labs+browser-cli@0.2.15/node_modules:/home/user/.local/share/pnpm/global/5/.pnpm/node_modules"
else
  export NODE_PATH="/home/user/.local/share/pnpm/global/5/.pnpm/@phnx-labs+browser-cli@0.2.15/node_modules/@phnx-labs/browser-cli/node_modules:/home/user/.local/share/pnpm/global/5/.pnpm/@phnx-labs+browser-cli@0.2.15/node_modules:/home/user/.local/share/pnpm/global/5/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/global/5/.pnpm/@phnx-labs+browser-cli@0.2.15/node_modules/@phnx-labs/browser-cli/bin/browser.cjs" "$@"
else
  exec node  "$basedir/global/5/.pnpm/@phnx-labs+browser-cli@0.2.15/node_modules/@phnx-labs/browser-cli/bin/browser.cjs" "$@"
fi
